{
  "name": "flow-builder-backend",
  "version": "0.0.1",
  "description": "NestJS Backend for Flow Builder",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "migrate": "ts-node src/scripts/migrate-projects.ts",
    "test": "ts-node test/control-blocks.spec.ts",
    "test:control": "ts-node test/control-blocks.spec.ts",
    "test:artifact": "ts-node test/artifact.spec.ts",
    "test:reliability": "ts-node test/run-reliability.spec.ts",
    "test:shape": "ts-node test/graph-shape.service.spec.ts",
    "test:all": "ts-node test/control-blocks.spec.ts && ts-node test/artifact.spec.ts && ts-node test/run-reliability.spec.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/mongoose": "^10.0.4",
    "@nestjs/platform-express": "^10.3.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "mongoose": "^8.2.0",
    "playwright": "^1.62.1",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  }
}
