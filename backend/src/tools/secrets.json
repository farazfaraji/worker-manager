{
  "name": "Secrets",
  "type": "secrets",
  "description": "Read or update a project secret. Prefer {{secrets.NAME}} in other nodes so the value is not stored on the run.",
  "inputs": [
    {
      "name": "operation",
      "label": "Operation",
      "type": "select",
      "defaultValue": "get",
      "options": [
        { "label": "Get", "value": "get" },
        { "label": "Set", "value": "set" },
        { "label": "Delete", "value": "delete" },
        { "label": "List", "value": "list" },
        { "label": "Exists", "value": "exists" }
      ]
    },
    {
      "name": "name",
      "label": "Name",
      "type": "text",
      "placeholder": "GITHUB_TOKEN",
      "helpText": "UPPER_SNAKE_CASE name, unique within the project.",
      "dependsOn": { "field": "operation", "in": ["get", "set", "delete", "exists"] }
    },
    {
      "name": "value",
      "label": "Value",
      "type": "valueOrVariable",
      "helpText": "Stored encrypted. The value is not returned by list.",
      "dependsOn": { "field": "operation", "equals": "set" }
    },
    {
      "name": "description",
      "label": "Description",
      "type": "text",
      "dependsOn": { "field": "operation", "equals": "set" }
    }
  ],
  "outputs": [
    { "name": "result", "label": "Result", "type": "object" },
    { "name": "true", "label": "True", "type": "branch", "dependsOn": { "field": "operation", "equals": "exists" } },
    { "name": "false", "label": "False", "type": "branch", "dependsOn": { "field": "operation", "equals": "exists" } }
  ]
}
