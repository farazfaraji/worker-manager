{
  "name": "Artifact",
  "type": "artifact",
  "description": "Store and version project documents. Each artifact has a stable logical ID, a type, one category, and optional tags.",
  "inputs": [
    {
      "name": "operation",
      "label": "Operation",
      "type": "select",
      "defaultValue": "create",
      "options": [
        { "label": "Create", "value": "create" },
        { "label": "Get", "value": "get" },
        { "label": "List", "value": "list" },
        { "label": "List versions", "value": "listVersions" },
        { "label": "Update", "value": "update" },
        { "label": "Compare versions", "value": "diff" },
        { "label": "Approve", "value": "approve" },
        { "label": "Reject", "value": "reject" },
        { "label": "Archive", "value": "archive" },
        { "label": "Unarchive", "value": "unarchive" },
        { "label": "Restore version", "value": "restore" },
        { "label": "Delete", "value": "delete" },
        { "label": "Add relation", "value": "addRelation" },
        { "label": "Get relations", "value": "getRelations" },
        { "label": "Remove relation", "value": "removeRelation" }
      ]
    },
    {
      "name": "projectId",
      "label": "Project",
      "type": "slug",
      "placeholder": "e.g. checkout, customer-portal",
      "helpText": "Project that owns this artifact. When the flow runs inside a project, this defaults to that project."
    },
    {
      "name": "logicalId",
      "label": "Logical ID",
      "type": "valueOrVariable",
      "placeholder": "e.g. checkout-prd",
      "helpText": "Stable name for the artifact across every version. Leave blank on create to generate one.",
      "dependsOn": {
        "field": "operation",
        "in": ["create", "get", "listVersions", "update", "diff", "approve", "reject", "archive", "unarchive", "restore", "delete", "addRelation", "getRelations"]
      }
    },
    {
      "name": "version",
      "label": "Version",
      "type": "valueOrVariable",
      "placeholder": "latest, or a version number",
      "helpText": "Which version to use. Leave blank or enter latest for the current version. Restore copies this version into a new draft.",
      "dependsOn": {
        "field": "operation",
        "in": ["get", "approve", "reject", "archive", "unarchive", "restore", "delete"]
      }
    },
    {
      "name": "ifExists",
      "label": "If it already exists",
      "type": "select",
      "defaultValue": "error",
      "helpText": "What to do when the logical ID is already used in this project.",
      "options": [
        { "label": "Fail", "value": "error" },
        { "label": "Return the existing artifact", "value": "return" },
        { "label": "Update the existing artifact", "value": "update" }
      ],
      "dependsOn": { "field": "operation", "equals": "create" }
    },
    {
      "name": "expectedVersion",
      "label": "Expected version",
      "type": "number",
      "helpText": "Fails with a conflict if the current version is not this number. Use it so two runs cannot overwrite each other.",
      "dependsOn": {
        "field": "operation",
        "in": ["update", "approve", "reject", "archive", "restore"]
      }
    },
    {
      "name": "idempotencyKey",
      "label": "Idempotency key",
      "type": "valueOrVariable",
      "placeholder": "e.g. {{run.id}}-checkout-prd",
      "helpText": "If this key was already used in the project, the original artifact is returned and no second copy is created.",
      "dependsOn": { "field": "operation", "in": ["create", "update"] }
    },
    {
      "name": "title",
      "label": "Title",
      "type": "valueOrVariable",
      "placeholder": "e.g. Checkout PRD",
      "dependsOn": { "field": "operation", "in": ["create", "update"] }
    },
    {
      "name": "type",
      "label": "Type",
      "type": "valueOrVariable",
      "defaultValue": "document",
      "helpText": "What this artifact is. Choose a suggestion or type your own.",
      "options": [
        { "label": "High-level concept", "value": "high-level" },
        { "label": "Product requirements (PRD)", "value": "prd" },
        { "label": "Technical specification", "value": "tech-spec" },
        { "label": "Task / plan", "value": "task" },
        { "label": "Decision", "value": "decision" },
        { "label": "Change request", "value": "change" },
        { "label": "Document", "value": "document" },
        { "label": "Code", "value": "code" }
      ],
      "dependsOn": { "field": "operation", "in": ["create", "update"] }
    },
    {
      "name": "category",
      "label": "Category",
      "type": "valueOrVariable",
      "defaultValue": "general",
      "placeholder": "e.g. authentication, billing, checkout",
      "helpText": "The one subject this artifact belongs to, like a folder. Use tags for extra labels.",
      "dependsOn": { "field": "operation", "in": ["create", "update"] }
    },
    {
      "name": "tags",
      "label": "Tags",
      "type": "valueOrVariable",
      "placeholder": "auth, jwt, token-rotation",
      "helpText": "Optional search labels. Separate them with commas or new lines.",
      "accepts": ["array", "string"],
      "dependsOn": { "field": "operation", "in": ["create", "update"] }
    },
    {
      "name": "format",
      "label": "Format",
      "type": "select",
      "defaultValue": "markdown",
      "options": [
        { "label": "Markdown", "value": "markdown" },
        { "label": "Plain text", "value": "text" },
        { "label": "JSON", "value": "json" },
        { "label": "Code", "value": "code" }
      ],
      "dependsOn": { "field": "operation", "in": ["create", "update"] }
    },
    {
      "name": "language",
      "label": "Language",
      "type": "valueOrVariable",
      "placeholder": "e.g. typescript, python, sql",
      "helpText": "Programming language when the format is code.",
      "dependsOn": { "field": "operation", "in": ["create", "update"] }
    },
    {
      "name": "content",
      "label": "Content",
      "type": "valueOrVariable",
      "multiline": true,
      "rows": 8,
      "placeholder": "Markdown, text, JSON, or {{agent_1.content}}",
      "dependsOn": { "field": "operation", "in": ["create", "update"] }
    },
    {
      "name": "changeSummary",
      "label": "Change summary",
      "type": "valueOrVariable",
      "placeholder": "What changed in this version",
      "dependsOn": { "field": "operation", "in": ["update", "restore"] }
    },
    {
      "name": "author",
      "label": "Author",
      "type": "valueOrVariable",
      "placeholder": "person, agent, or flow name",
      "dependsOn": { "field": "operation", "in": ["create", "update", "approve", "reject"] }
    },
    {
      "name": "reason",
      "label": "Reason",
      "type": "valueOrVariable",
      "placeholder": "Why this version was rejected",
      "dependsOn": { "field": "operation", "equals": "reject" }
    },
    {
      "name": "metadata",
      "label": "Metadata",
      "type": "valueOrVariable",
      "placeholder": "{ \"confidence\": 0.9 }",
      "helpText": "Extra JSON stored with this version.",
      "dependsOn": { "field": "operation", "in": ["create", "update", "approve", "reject"] }
    },
    {
      "name": "fromVersion",
      "label": "From version",
      "type": "number",
      "dependsOn": { "field": "operation", "equals": "diff" }
    },
    {
      "name": "toVersion",
      "label": "To version",
      "type": "number",
      "dependsOn": { "field": "operation", "equals": "diff" }
    },
    {
      "name": "diffFormat",
      "label": "Diff format",
      "type": "select",
      "defaultValue": "summary",
      "options": [
        { "label": "Summary", "value": "summary" },
        { "label": "Line diff", "value": "unified" },
        { "label": "JSON", "value": "json" }
      ],
      "dependsOn": { "field": "operation", "equals": "diff" }
    },
    {
      "name": "query",
      "label": "Search",
      "type": "valueOrVariable",
      "placeholder": "title, logical ID, category, or tag",
      "dependsOn": { "field": "operation", "equals": "list" }
    },
    {
      "name": "filterType",
      "label": "Type",
      "type": "valueOrVariable",
      "options": [
        { "label": "Any type", "value": "" },
        { "label": "High-level concept", "value": "high-level" },
        { "label": "Product requirements (PRD)", "value": "prd" },
        { "label": "Technical specification", "value": "tech-spec" },
        { "label": "Task / plan", "value": "task" },
        { "label": "Decision", "value": "decision" },
        { "label": "Change request", "value": "change" },
        { "label": "Document", "value": "document" },
        { "label": "Code", "value": "code" }
      ],
      "dependsOn": { "field": "operation", "equals": "list" }
    },
    {
      "name": "filterCategory",
      "label": "Category",
      "type": "valueOrVariable",
      "placeholder": "e.g. billing",
      "dependsOn": { "field": "operation", "equals": "list" }
    },
    {
      "name": "filterTags",
      "label": "Tags",
      "type": "valueOrVariable",
      "placeholder": "e.g. jwt, auth",
      "helpText": "Returns artifacts that have any of these tags.",
      "dependsOn": { "field": "operation", "equals": "list" }
    },
    {
      "name": "filterStatus",
      "label": "Status",
      "type": "select",
      "options": [
        { "label": "Any status", "value": "" },
        { "label": "Draft", "value": "draft" },
        { "label": "In review", "value": "in-review" },
        { "label": "Approved", "value": "approved" },
        { "label": "Rejected", "value": "rejected" },
        { "label": "Archived", "value": "archived" }
      ],
      "dependsOn": { "field": "operation", "equals": "list" }
    },
    {
      "name": "latestOnly",
      "label": "Latest version only",
      "type": "boolean",
      "defaultValue": true,
      "dependsOn": { "field": "operation", "equals": "list" }
    },
    {
      "name": "includeContent",
      "label": "Include content",
      "type": "boolean",
      "defaultValue": false,
      "helpText": "Turn this on to return full document bodies. Leave it off when you only need titles and IDs.",
      "dependsOn": { "field": "operation", "equals": "list" }
    },
    {
      "name": "limit",
      "label": "Limit",
      "type": "number",
      "defaultValue": 50,
      "dependsOn": { "field": "operation", "equals": "list" }
    },
    {
      "name": "offset",
      "label": "Offset",
      "type": "number",
      "defaultValue": 0,
      "dependsOn": { "field": "operation", "equals": "list" }
    },
    {
      "name": "sortBy",
      "label": "Sort by",
      "type": "select",
      "defaultValue": "updatedAt",
      "options": [
        { "label": "Updated", "value": "updatedAt" },
        { "label": "Created", "value": "createdAt" },
        { "label": "Title", "value": "title" },
        { "label": "Version", "value": "version" }
      ],
      "dependsOn": { "field": "operation", "equals": "list" }
    },
    {
      "name": "sortOrder",
      "label": "Sort order",
      "type": "select",
      "defaultValue": "desc",
      "options": [
        { "label": "Newest first", "value": "desc" },
        { "label": "Oldest first", "value": "asc" }
      ],
      "dependsOn": { "field": "operation", "equals": "list" }
    },
    {
      "name": "targetLogicalId",
      "label": "Target logical ID",
      "type": "valueOrVariable",
      "placeholder": "e.g. checkout-spec",
      "dependsOn": { "field": "operation", "equals": "addRelation" }
    },
    {
      "name": "relationType",
      "label": "Relation",
      "type": "select",
      "defaultValue": "relates-to",
      "helpText": "The opposite relation is created automatically.",
      "options": [
        { "label": "Refines", "value": "refines" },
        { "label": "Has tech spec", "value": "has-techspec" },
        { "label": "Decomposes to", "value": "decomposes-to" },
        { "label": "Depends on", "value": "depends-on" },
        { "label": "Constrains", "value": "constrains" },
        { "label": "Derived from", "value": "derived-from" },
        { "label": "Conflicts with", "value": "conflicts-with" },
        { "label": "Relates to", "value": "relates-to" }
      ],
      "dependsOn": { "field": "operation", "equals": "addRelation" }
    },
    {
      "name": "relationMetadata",
      "label": "Relation metadata",
      "type": "valueOrVariable",
      "placeholder": "{ \"confidence\": 0.95 }",
      "dependsOn": { "field": "operation", "equals": "addRelation" }
    },
    {
      "name": "relationDirection",
      "label": "Direction",
      "type": "select",
      "defaultValue": "both",
      "options": [
        { "label": "Both", "value": "both" },
        { "label": "Outgoing", "value": "outgoing" },
        { "label": "Incoming", "value": "incoming" }
      ],
      "dependsOn": { "field": "operation", "equals": "getRelations" }
    },
    {
      "name": "relationId",
      "label": "Relation ID",
      "type": "valueOrVariable",
      "dependsOn": { "field": "operation", "equals": "removeRelation" }
    }
  ],
  "outputs": [
    { "name": "onSuccess", "label": "On Success", "type": "branch" },
    { "name": "onUnchanged", "label": "On Unchanged", "type": "branch" },
    { "name": "onNotFound", "label": "On Not Found", "type": "branch" },
    { "name": "onConflict", "label": "On Conflict", "type": "branch" },
    { "name": "onFailed", "label": "On Failed", "type": "branch" }
  ]
}
